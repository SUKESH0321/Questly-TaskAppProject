# Copy to backend/.env and fill in. NEVER commit backend/.env.
MONGODB_URI=mongodb://localhost:27017/questly
# Long random string (32+ chars). Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
PORT=3001
# NODE_ENV=production
# Comma-separated allowed web origins. Default already allows localhost:5173 and Capacitor (Android/iOS) origins.
# CORS_ORIGIN=https://your-site.example.com
# ---- Phone verification (SMS OTP) ----
# console = DEV ONLY: prints the code in the server log and shows it in the app. Refused in production.
# twilio  = needs TWILIO_ACCOUNT_SID, TWILIO_AUTH_TOKEN and TWILIO_FROM (or TWILIO_MESSAGING_SERVICE_SID)
# msg91   = needs MSG91_AUTH_KEY and MSG91_TEMPLATE_ID (an approved DLT template using ##OTP##)
SMS_PROVIDER=console

# ---- Identity (Aadhaar) verification ----
# none    = not available; taskers are NOT blocked (default)
# sandbox = DEV ONLY: simulates a successful check. Refused in production.
# A real provider (Digio, Signzy, Setu, IDfy, Surepass, DigiLocker) must be added in backend/src/utils/kyc.ts.
KYC_PROVIDER=none
# When a provider is active, taskers must be ID-verified to apply. Set false to make it optional.
# KYC_REQUIRED=true

# Demo data is seeded automatically outside production. Set to true/false to override.
# SEED_DEMO_DATA=false
