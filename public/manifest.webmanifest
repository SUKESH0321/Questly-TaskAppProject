{
  "name": "Questly",
  "short_name": "Questly",
  "description": "Hyperlocal task marketplace: post a task, pick a local tasker, pay safely through escrow.",
  "id": "./",
  "start_url": "./home",
  "scope": "./",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#faf7f2",
  "theme_color": "#faf7f2",
  "categories": ["lifestyle", "productivity"],
  "icons": [
    { "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "icons/maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    { "name": "Post a task", "url": "./tasks/create", "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "Browse tasks", "url": "./tasks", "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }] }
  ]
}
